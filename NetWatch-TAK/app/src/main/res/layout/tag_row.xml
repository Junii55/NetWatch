<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/nw_surface"
    android:padding="10dp">

    <!-- Colour swatch: the same colour the tag has in the desktop app and on the
         map, so the three agree at a glance. -->
    <TextView
        android:id="@+id/row_swatch"
        android:layout_width="12dp"
        android:layout_height="34dp"
        android:background="@color/nw_accent"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Tag" />

        <TextView
            android:id="@+id/row_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nw_muted"
            android:textSize="11sp"
            android:paddingTop="2dp"
            android:text="" />
    </LinearLayout>

    <Button
        android:id="@+id/row_goto"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="56dp"
        android:text="Go to"
        style="@style/darkButton" />
</LinearLayout>
