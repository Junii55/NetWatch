<?xml version="1.0" encoding="utf-8"?>
<!-- Plugin icon in ATAK's plugin list: the toolbar mark on a dark plate. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0b0d10" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#1f6f66" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_netwatch"
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp" />
</layer-list>
